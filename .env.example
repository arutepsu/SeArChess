# Searchess — environment variable template.
# Copy to .env, fill in real values, and never commit .env.
#
# Used by:
#   docker compose -f deployment/compose/docker-compose.yml up -d
#   (also read automatically by the root docker-compose.yml)

# ── Database credentials ──────────────────────────────────────────────────────
# Shared by game-service and history-service (both connect to the same Postgres instance).
SEARCHESS_POSTGRES_USER=searchess
SEARCHESS_POSTGRES_PASSWORD=change_me_before_use
SEARCHESS_POSTGRES_SCHEMA=game

# ── History Service storage ───────────────────────────────────────────────────
# history-service stores archive records in Postgres (same instance as game-service).
# Override only if history-service connects to a separate Postgres instance.
# HISTORY_POSTGRES_URL=jdbc:postgresql://postgres:5432/searchess
# HISTORY_POSTGRES_USER=searchess
# HISTORY_POSTGRES_PASSWORD=change_me_before_use
HISTORY_POSTGRES_SCHEMA=history

# ── Persistence mode ──────────────────────────────────────────────────────────
# Options: postgres | mongo | sqlite | in-memory
# Default when unset: postgres
PERSISTENCE_MODE=postgres

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin allowed to call the game-service API directly (not via Envoy).
# For local frontend dev this is typically the Vite dev server.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── History delivery mode ─────────────────────────────────────────────────────
# Options: redis-stream (default) | http
# redis-stream: game-service publishes to Redis Stream; history-service consumes.
# http: game-service POSTs directly to history-service (best-effort).
HISTORY_DELIVERY_MODE=redis-stream
HISTORY_INGESTION_MODE=redis-stream
HISTORY_REDIS_URL=redis://redis:6379
HISTORY_REDIS_STREAM=searchess.history.archives
HISTORY_REDIS_GROUP=history-service

# ── AI engine ────────────────────────────────────────────────────────────────
# Options: random-legal
# (additional engines may be added later)
AI_ENGINE_ID=random-legal

# ── AI supervised model artifacts ────────────────────────────────────────────
# Host directory containing all artifact run_* subdirectories.
# Mounted read-only into the searchess-ai-service container at /artifacts.
AI_ARTIFACT_ROOT=/path/to/artifacts

# Which run directory to load as the active supervised model.
# Set to the run_* directory name inside AI_ARTIFACT_ROOT.
MODEL_RUN_ID=run_YYYYMMDD_HHMMSS_xxxxxxxx

# ── AI test mode ─────────────────────────────────────────────────────────────
# Leave blank for normal operation.
AI_REMOTE_TEST_MODE=

# External-game / Lichess bot integration.
# Use one strong shared value for Game Service and lichess-bot.
# Leave EXTERNAL_GAME_BOT_API_KEY empty to keep /external-games unmounted.
EXTERNAL_GAME_BOT_API_KEY=
EXTERNAL_GAME_BOT_PLATFORM=Lichess
EXTERNAL_GAME_BOT_ACTOR_ID=selinasa

# Real Lichess bot OAuth token. Required only when starting the lichess-bot service.
LICHESS_BOT_TOKEN=

# Internal URL used by lichess-bot in Compose/Kubernetes. Do not use localhost in containers.
GAME_SERVICE_BASE_URL=http://game-service:8080

# ── Migration admin endpoint ─────────────────────────────────────────────────
# Set MIGRATION_ADMIN_ENABLED=true and supply a strong token to enable
# the POST /admin/migrations endpoint (used for manual schema upgrades).
MIGRATION_ADMIN_ENABLED=false
MIGRATION_ADMIN_TOKEN=

# ── Grafana ───────────────────────────────────────────────────────────────────
# Admin UI password for Grafana (http://localhost:3000, user: admin).
GRAFANA_ADMIN_PASSWORD=admin

# ── Analytics Service storage ─────────────────────────────────────────────────
# analytics-service is a read-only HTTP API over Postgres tables written by
# spark-analytics. Same Postgres instance as game-service/history-service.
ANALYTICS_POSTGRES_SCHEMA=public
# ANALYTICS_POSTGRES_URL=jdbc:postgresql://postgres:5432/searchess
# ANALYTICS_POSTGRES_USER=searchess
# ANALYTICS_POSTGRES_PASSWORD=change_me_before_use

# ── Tournament Service storage ────────────────────────────────────────────────
# Options: memory | postgres
TOURNAMENT_JOB_STORE=postgres
TOURNAMENT_POSTGRES_SCHEMA=public
# TOURNAMENT_POSTGRES_URL=jdbc:postgresql://postgres:5432/searchess
# TOURNAMENT_POSTGRES_USER=searchess
# TOURNAMENT_POSTGRES_PASSWORD=change_me_before_use

# Directory where tournament-service writes JSONL game-event output.
TOURNAMENT_OUTPUT_BASE_PATH=/data/tournament-jobs

# ── Tournament outbox publisher ───────────────────────────────────────────────
# Options: logging | noop | kafka
# logging (this phase's default) just logs each outbox event; no broker needed.
TOURNAMENT_OUTBOX_PUBLISHER_ENABLED=true
TOURNAMENT_OUTBOX_PUBLISHER_TYPE=logging
TOURNAMENT_OUTBOX_POLL_INTERVAL_SECONDS=5
TOURNAMENT_OUTBOX_BATCH_SIZE=50
TOURNAMENT_OUTBOX_MAX_ATTEMPTS=10

# ── Tournament Kafka publisher (NOT used locally — disabled by default) ───────
# No Kafka broker is deployed in local Compose. Do not set
# TOURNAMENT_OUTBOX_PUBLISHER_TYPE=kafka until a broker exists; the
# tournament-service config will reject it without TOURNAMENT_KAFKA_BOOTSTRAP_SERVERS.
# TOURNAMENT_KAFKA_BOOTSTRAP_SERVERS=
# TOURNAMENT_KAFKA_TOPIC=searchess.tournament.lifecycle.v1
# TOURNAMENT_KAFKA_CLIENT_ID=searchess-tournament-service
# TOURNAMENT_KAFKA_ACKS=all

# ── Gateway Service ───────────────────────────────────────────────────────────
# gateway-service proxies the public tournament-server at 141.37.123.132:8086.
# Browser calls /api/gateway/*; gateway authenticates with tournament-server
# server-side. The external JWT is never forwarded to the browser.
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8087
TOURNAMENT_SERVER_URL=http://141.37.123.132:8086
# Set to true only for local dev without Keycloak. Never true in production.
GATEWAY_AUTH_DISABLED=false
# Dev identity used when GATEWAY_AUTH_DISABLED=true.
GATEWAY_DEV_USER_NAME=dev-director

# ── Tournament bot evaluation ─────────────────────────────────────────────────
# Stockfish: installed inside the tournament-service image via apt (stockfish package).
# Binary path /usr/games/stockfish is set in docker-compose.yml and K8s ConfigMap —
# no change needed here for Docker/K8s runs.
# For local host dev (sbt tournamentService/run on Windows), override with your Windows path:
# STOCKFISH_PATH=C:/path/to/stockfish.exe
#
# SearchessAI: tournament-service calls ai-service over internal Docker/K8s DNS.
# Set in docker-compose.yml (http://searchess-ai-service:8765 for root dev compose,
# http://ai-service:8765 for deployment/compose and K8s) — no change needed here.
# For local host dev (sbt tournamentService/run), set to a running ai-service instance:
# SEARCHESS_AI_BASE_URL=http://localhost:8765
