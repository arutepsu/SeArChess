# syntax=docker/dockerfile:1
#
# Packages GameEventStreamingAnalyticsJob as a long-running container.
# No HTTP service — the job reads from Kafka, writes to public.live_game_results via JDBC,
# and blocks on spark.streams.awaitAnyTermination().
#
# entry point: bin/run-live-analytics.sh
#   overrides APP_MAIN_CLASS → chess.analytics.app.GameEventStreamingAnalyticsJob
#   (the staged bin/spark-analytics binary defaults to the batch job GameAnalyticsJob)
#
# Configuration: all env vars — see deployment/k8s/base/spark-analytics/configmap.yaml

FROM sbtscala/scala-sbt:eclipse-temurin-21.0.8_9_1.12.6_3.8.2 AS build

WORKDIR /build

COPY project/ project/
COPY build.sbt ./
COPY apps/ apps/
COPY modules/ modules/

RUN sbt "sparkAnalytics / stage"

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /build/apps/spark-analytics/target/universal/stage/ ./
COPY apps/spark-analytics/docker/run-live-analytics.sh ./bin/run-live-analytics.sh

RUN chmod +x ./bin/run-live-analytics.sh ./bin/spark-analytics ./bin/game-event-streaming-analytics-job

CMD ["bin/run-live-analytics.sh"]
