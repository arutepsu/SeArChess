# Local Compose + Keycloak auth mode — committed, no secrets.
# Used by: npm run dev:auth
#
# Ports:
#   Compose Envoy API:  http://localhost:11000  (host 11000 → container 10000)
#   Keycloak:           http://localhost:8080
#   k3d API (untouched):http://localhost:10000  — do NOT use this env file with k3d
#
# To run:
#   docker compose -f deployment/compose/docker-compose.yml up keycloak envoy game-service ...
#   npm run dev:auth
#
# Routing: browser → Vite proxy (same-origin, no CORS) → Envoy :11000
# Envoy routes /api/* → game-service (strips /api prefix).
# WebSocket: browser → ws://localhost:5173/ws → Vite proxy → ws://localhost:11000/ws → game-service.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=searchess
VITE_KEYCLOAK_CLIENT_ID=searchess-web
VITE_API_BASE_URL=
VITE_API_PATH_PREFIX=/api
VITE_DEV_PROXY_TARGET=http://localhost:11000
VITE_WS_URL=
VITE_ANALYTICS_PROXY_TARGET=http://localhost:8084
