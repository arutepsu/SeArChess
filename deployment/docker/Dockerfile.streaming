# syntax=docker/dockerfile:1

FROM sbtscala/scala-sbt:eclipse-temurin-21.0.8_9_1.12.6_3.8.2 AS build

WORKDIR /build

COPY project/ project/
COPY build.sbt ./
COPY backend/ backend/
COPY modules/ modules/

RUN sbt "chessStreaming / stage"

FROM eclipse-temurin:21-jre

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/backend/services/chess-streaming/target/universal/stage/ ./
COPY backend/services/chess-streaming/index.html ./index.html

EXPOSE 8082

ENV STREAMING_HOST=0.0.0.0 \
    STREAMING_PORT=8082 \
    INDEX_HTML_PATH=/app/index.html

CMD ["bin/searchess-chess-streaming"]
