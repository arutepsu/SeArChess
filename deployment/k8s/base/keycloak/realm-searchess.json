{
  "realm": "searchess",
  "displayName": "SeArChess",
  "loginTheme": "searchess",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "searchess-user",
        "description": "Standard demo user role for SeArChess",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "searchess-web",
      "name": "Searchess Web",
      "description": "Browser frontend — public client, Authorization Code + PKCE S256",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:10000/*",
        "http://localhost:10000/*",
        "http://localhost:18000",
        "http://localhost:18000/",
        "http://localhost:18000/*",
        "http://127.0.0.1:18000",
        "http://127.0.0.1:18000/",
        "http://127.0.0.1:18000/*",
        "http://localhost:18080",
        "http://localhost:18080/",
        "http://localhost:18080/*",
        "http://127.0.0.1:18080",
        "http://127.0.0.1:18080/",
        "http://127.0.0.1:18080/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:10000",
        "http://localhost:10000",
        "http://localhost:18000",
        "http://127.0.0.1:18000",
        "http://localhost:18080",
        "http://127.0.0.1:18080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "searchess-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "searchess-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "searchess-api",
      "name": "SeArChess API",
      "description": "Resource server — bearer-only, used only for audience claim validation",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["searchess-user"]
    }
  ]
}
