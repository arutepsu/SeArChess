# Deployed-backend mode — committed, no secrets.
# Used by: npm run dev:deployed
# Requires SSH tunnel:
#   ssh -N -L 18000:127.0.0.1:10000 chess@141.37.74.145
# Or kubectl port-forward:
#   kubectl port-forward -n searchess svc/envoy 10000:10000 &
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=searchess
VITE_KEYCLOAK_CLIENT_ID=searchess-web
VITE_API_BASE_URL=
VITE_API_PATH_PREFIX=/api
VITE_DEV_PROXY_TARGET=http://127.0.0.1:18000
VITE_WS_URL=
